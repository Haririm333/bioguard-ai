# ==============================================================
# BIOGUARD AI - Backend Configuration (.env)
# ==============================================================
# NOTE: BIOGUARD AI runs 100% locally with zero API keys required out of the box!
# If you wish to connect real external APIs, add your keys below:

# Optional: Mapbox Satellite / High-Resolution Basemap
MAPBOX_ACCESS_TOKEN=

# Optional: AI Agronomic Explanations & LLM Synthesis (OpenAI / Anthropic / Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Satellite & Remote Sensing (Sentinel Hub / Planet Labs)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Optional: Real Weather Data (OpenWeatherMap / Tomorrow.io)
OPENWEATHER_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
